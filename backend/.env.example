# ===== Server =====
# Note: macOS uses port 5000 for AirPlay Receiver, so we default to 5001.
PORT=5001
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS).
# The Next.js dev server runs on http://localhost:3000.
CLIENT_URL=http://localhost:3000

# ===== Database =====
# USE_MEMORY_DB=true spins up a throwaway in-memory MongoDB (no install needed);
# data resets on restart. Set it to false and point MONGO_URI at real MongoDB
# (local or Atlas) for persistent data.
USE_MEMORY_DB=true
# MongoDB Atlas (a shared cluster is fine):
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/FDE
# The app FORCES this database name regardless of what MONGO_URI points at, so no
# other database on a shared/company cluster is ever touched. Leave as FDE.
DB_NAME=FDE

# ===== Auth =====
# Use a long random string in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ===== Payment =====
# Platform access price in paise (9900 = ₹99.00)
COURSE_PRICE=9900
CURRENCY=INR

# Razorpay keys — get TEST keys from https://dashboard.razorpay.com (Settings → API Keys).
# If these are left blank, the backend runs in MOCK payment mode so you can demo
# the full ₹99 flow without a Razorpay account (no money moves).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ===== Email (password reset) =====
# Leave SMTP_* blank to run in DEV email mode: the reset link is logged to the
# server console and returned by the API so you can test without a mail provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AI Forward Deployed Engineer <no-reply@fde.local>"

# ===== LMS redirect (optional) =====
# Where to send the student after a successful payment. Leave blank to just show
# the unlocked dashboard.
LMS_URL=
